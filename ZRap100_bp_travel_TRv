  METHOD calculateTotalPrice.
    " 1. อ่านค่า BookingFee จากหน้าจอมา
    READ ENTITIES OF zrap100_r_traveltp_trv IN LOCAL MODE
      ENTITY Travel
      FIELDS ( BookingFee )
      WITH CORRESPONDING #( keys )
      RESULT DATA(travels).

    DATA travels_for_update TYPE TABLE FOR UPDATE zrap100_r_traveltp_trv.

    " 2. วนลูปคำนวณ (Logic เดียวกับปุ่ม VAT เลยครับ แต่ย้ายมาทำตรงนี้)
    LOOP AT travels INTO DATA(travel).

      " สูตร: TotalPrice = BookingFee + VAT 7%
      DATA(amount_with_vat) = travel-BookingFee * ( 1 + '0.07' ).

      " เตรียมค่าที่จะอัปเดต
      APPEND VALUE #( %tky = travel-%tky
                      TotalPrice = amount_with_vat
*                      Description = |{ travel-Description } (Auto VAT)| " (ของแถม) เติมคำว่า Auto ให้รู้ว่าระบบคิดให้
                    ) TO travels_for_update.
    ENDLOOP.

    " 3. สั่งอัปเดตลงตาราง Draft ทันที
    MODIFY ENTITIES OF zrap100_r_traveltp_trv IN LOCAL MODE
      ENTITY Travel
      UPDATE FIELDS ( TotalPrice Description )
      WITH travels_for_update.


  ENDMETHOD.

METHOD initData.
    READ ENTITIES OF ZRAP100_R_TRAVELTP_TRV IN LOCAL MODE
      ENTITY Travel
      ALL FIELDS WITH CORRESPONDING #( keys )
      RESULT DATA(travels).

    DATA travels_for_update TYPE TABLE FOR UPDATE ZRAP100_R_TRAVELTP_TRV.

    LOOP AT travels INTO DATA(travel).
      APPEND VALUE #(
        %tky = travel-%tky
        " ใส่วันที่วันนี้ (ซึ่งจะผ่าน Validation ของคุณแน่นอน)
        BeginDate = cl_abap_context_info=>get_system_date( )
        EndDate   = cl_abap_context_info=>get_system_date( ) + 7
        CurrencyCode = 'THB'
        OverallStatus = 'O'
      ) TO travels_for_update.
    ENDLOOP.

    MODIFY ENTITIES OF ZRAP100_R_TRAVELTP_TRV IN LOCAL MODE
      ENTITY Travel
      UPDATE FIELDS ( BeginDate EndDate CurrencyCode OverallStatus )
      WITH travels_for_update.
  ENDMETHOD.

